# EmailJS Configuration for Potentiaa Contact Form
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_contact_form_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_contact_form_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# EmailJS Configuration for Aagaz Passes Confirmation
NEXT_PUBLIC_EMAILJS_AXP_SERVICE_ID=your_axp_service_id
NEXT_PUBLIC_EMAILJS_AXP_TEMPLATE_ID=your_axp_template_id
NEXT_PUBLIC_EMAILJS_AXP_PUBLIC_KEY=your_emailjs_public_key
# The "Booked, balance due" email a pre-booking gets once its deposit is paid
# (no QR). Template HTML: docs/emailjs-booked-template.html. Without it that
# email is not sent; the guest still sees the same details on the booking page.
NEXT_PUBLIC_EMAILJS_AXP_BOOKED_TEMPLATE_ID=your_axp_booked_template_id

# ==========================================
# AAGAZ · AxP Social Event & Payment Config
# ==========================================
# Razorpay Credentials (from https://dashboard.razorpay.com/app/account-settings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for the webhook at /api/payments/webhook: without it every event
# is refused. Use the secret you entered when adding the webhook in Razorpay.
RAZORPAY_WEBHOOK_SECRET=
# Signs ticket QR codes and organiser sessions. Required in production: a
# long random value of your own, set once before passes go out (changing it
# later changes every pass QR already sent).
TICKET_SIGNING_SECRET=

# Firebase Admin: the guest database. Required: without these the server cannot
# read or save bookings, and in production a booking it cannot save is refused.
# From Firebase console > potentia-projects > Project settings > Service
# accounts > Generate new private key: copy client_email and private_key out of
# the downloaded JSON. Never commit that file. The database rules
# (firestore.rules) refuse everyone else.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional. Default potentia-projects; a key from another project is refused.
FIREBASE_PROJECT_ID=
# Optional. Default <project>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=


# ==========================================
# WhatsApp Business Cloud API · pass delivery
# ==========================================
# Each attendee gets their own pass on WhatsApp once payment is verified.
# The organiser must also tick "WhatsApp pass delivery" at /axp-social/admin;
# without that tick nothing is sent, even with these set.
#
# From Meta Business Manager > WhatsApp > API setup:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# The approved template. Its body must take six parameters, in this order:
#   {{1}} attendee name   {{2}} pass type    {{3}} event name
#   {{4}} date and venue  {{5}} booking ref  {{6}} entry code
WHATSAPP_TEMPLATE_NAME=aagaz_pass_confirmation
WHATSAPP_TEMPLATE_LOCALE=en
WHATSAPP_API_VERSION=v21.0
# Country code prepended to attendee numbers saved without one
WHATSAPP_DEFAULT_COUNTRY=91
# The template's image header carries each attendee's QR. Only set this false
# if your approved template has no header, or Meta rejects every send.
WHATSAPP_TEMPLATE_HAS_IMAGE=true

# Balance reminder emails run every morning from vercel.json (Vercel Cron).
# Vercel signs each call with this secret; without it the reminder route
# refuses every call. Any long random value.
CRON_SECRET=

# Organiser PIN for /axp-social/admin and /axp-social/dashboard. Required in
# production: without it (and TICKET_SIGNING_SECRET) organiser sign-in is off.
AXP_ADMIN_PIN=

# ==========================================
# Meta Pixel · ad tracking
# ==========================================
# Reports what visitors from Meta ads do on /axp-social and /axp-social/stalls:
# page views, viewing the passes, phone and WhatsApp taps, starting checkout,
# each verified payment (Purchase) and stall enquiries (Lead). Without it
# nothing loads.
#
# From Meta Events Manager > your pixel > Settings: the Pixel ID (not secret).
META_PIXEL_ID=
