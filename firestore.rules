rules_version = '2';

// potentia-projects holds the Aagaz guest list: names, phone numbers, emails
// and dates of birth. Only the website's server reads or writes it, through
// the Firebase Admin SDK, which these rules do not apply to. No browser or app
// gets in directly, whatever config it holds.
//
// The project used to serve the dental prototype as well; that is retired, so
// nothing else needs access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
